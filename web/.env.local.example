# Local environment for `npm run dev` / `npm start` (Next.js reads `.env.local`).
#
#   1. cp .env.local.example .env.local
#   2. fill in the values below
#   3. npm run dev
#
# `.env.local` is git-ignored — never commit a real secret.
# The deployed app reads the same names from Vercel:
#   vercel env add EVE_URL production
#   vercel env pull            # writes .env.local from the project, incl. OIDC

# --- Durable eve agent (upgrades /chat) ----------------------------------
# When BOTH values are set, /chat switches from the stateless /api/chat agent
# to durable eve sessions: the conversation survives reloads, and voice
# messages become available (Gemini reads the audio natively on the agent
# side). Values come from the deployed trip-agent — the relay in
# app/api/agent/[...path]/route.ts calls `${EVE_URL}/eve/v1/...` with
# `Authorization: Basic base64("family:" + EVE_SHARED_SECRET)`.
# Neither value ever reaches the browser; the client only learns a boolean
# from GET /api/agent/enabled.
EVE_URL=https://trip-agent.example.vercel.app
EVE_SHARED_SECRET=

# --- AI Gateway (fallback chat + voice output) ---------------------------
# The fallback chat (/api/chat) and the read-aloud endpoint (/api/tts) run
# through the Vercel AI Gateway.
#
# On Vercel: nothing to set. The AI SDK authenticates with the deployment's
# OIDC token automatically — just make sure AI Gateway is enabled for the
# project (Vercel dashboard -> project -> AI Gateway).
#
# Locally: either run `vercel env pull` (which writes a VERCEL_OIDC_TOKEN into
# .env.local, refreshed every 12h), or paste a standalone key created at
# vercel.com -> AI Gateway -> API Keys. Every account includes $5 of free
# credit per month.
#
# With neither, POST /api/chat answers 503 and /chat shows a setup notice, and
# /api/tts answers 503 (the browser reads answers aloud instead).
# AI_GATEWAY_API_KEY=vck_...

# --- Optional ------------------------------------------------------------
# Override the model the concierge agent uses. Any slug from the gateway's
# model list works:  curl https://ai-gateway.vercel.sh/v1/models
# Defaults to anthropic/claude-sonnet-5.
# CHAT_MODEL=anthropic/claude-opus-5
#
# Voice output. Defaults to openai/tts-1 with the "nova" voice, which handles
# Hebrew acceptably. Any speech model the gateway exposes works.
# TTS_MODEL=openai/tts-1-hd
# TTS_VOICE=shimmer
